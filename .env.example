# Copy to .env and fill in. Never commit .env.

# --- Postgres (used by the db container) ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall
# Host port for the db container (5433 avoids clashing with a local Postgres on 5432)
DB_HOST_PORT=5433

# --- Backend ---
# Used when running the backend on your host (outside Docker).
# Inside docker-compose this is overridden to point at the "db" service.
DATABASE_URL=postgresql+asyncpg://recall:recall@localhost:5433/recall
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
# Database resilience: connects are retried with backoff (Neon cold starts, blips),
# and every wait is bounded. Pooled connections are recycled before Neon drops them.
DB_CONNECT_TIMEOUT_S=10
DB_CONNECT_RETRIES=3
DB_COMMAND_TIMEOUT_S=30
DB_POOL_TIMEOUT_S=10
DB_POOL_RECYCLE_S=300

# --- LLM ---
# openai | fake  ("fake" is a scripted echo model: lets you run the UI with no API key)
# "openai" speaks the OpenAI Chat Completions protocol, so it works with OpenAI itself
# or any compatible server (IFM, Ollama, vLLM, Together, ...) via LLM_BASE_URL.
# Names are LLM_* (not OPENAI_*) so they never clash with the OpenAI SDK's own env vars.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-5.4-mini
# Blank = api.openai.com. Examples: https://api.ifm.ai/v1, http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
# Reasoning models served via IFM (K2-Horizon) need this set to "reasoning". Leave blank for OpenAI.
LLM_REASONING_FIELD=
LLM_TIMEOUT_S=60
# Retries on 429 / 5xx / network errors (exponential backoff)
LLM_MAX_RETRIES=4
# Circuit breaker: after this many transient failures in a row (timeouts, 429, 5xx),
# fail fast for LLM_BREAKER_RESET_S instead of making every user wait out the retries.
# 0 disables the breaker.
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_RESET_S=30
# Optional fallback model, used when the primary is down (before any text has streamed).
# Base URL and key default to the primary's; set them to use a different provider.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_REASONING_FIELD=
# Past messages sent to the model per turn
CHAT_HISTORY_LIMIT=20

# --- Agent loop ---
# The turn timeout is a hard deadline: it also cuts off a model call that stalls
# mid-answer and tools that overrun. Memory recall gets its own small budget.
MEMORY_RECALL_TIMEOUT_S=5
AGENT_MAX_ITERATIONS=6
AGENT_TURN_TIMEOUT_S=120
TOOL_TIMEOUT_S=15
TOOL_MAX_RESULT_CHARS=4000

# --- Embeddings & RAG ---
# sentence_transformers (local, free, CPU) | fake (tests)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the vector(384) column; changing it needs a migration + re-embedding.
EMBEDDING_DIM=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Cosine similarity below which a passage is "not relevant" (agent then says it doesn't know)
RAG_MIN_SIMILARITY=0.5
MAX_UPLOAD_MB=20
INGEST_TIMEOUT_S=600
# Runs/ingestions orphaned by a crash or restart are failed once older than their
# timeout; this is how often to look (0 = never).
REAPER_INTERVAL_S=60

# ---- query_database (read-only SQL over the sample dataset) ----
# Login role created by `python -m app.datasets.seed`; it can only SELECT schema acme.
READONLY_DB_USER=recall_reader
READONLY_DB_PASSWORD=recall_reader
# Optional explicit URL; by default DATABASE_URL with the reader's credentials.
DATABASE_READONLY_URL=
# Where query_database runs: postgres (local dataset) or snowflake.
# For Snowflake: run `python -m app.datasets.snowflake_setup` (in backend/), run the
# generated secrets/snowflake_setup.sql in Snowsight, then fill in SNOWFLAKE_ACCOUNT.
SQL_BACKEND=postgres
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=RECALL_AGENT
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=RECALL_READER
SNOWFLAKE_WAREHOUSE=RECALL_WH
SNOWFLAKE_DATABASE=RECALL
SNOWFLAKE_SCHEMA=ACME
SQL_MAX_ROWS=50
SQL_STATEMENT_TIMEOUT_MS=5000

# ---- Long-term memory ----
# score = (0.7*relevance + 0.2*recency + 0.1*importance) / sum of weights
# (relevance = cosine similarity rescaled above MEMORY_MIN_SIMILARITY)
MEMORY_WEIGHT_SIMILARITY=0.7
MEMORY_WEIGHT_RECENCY=0.2
MEMORY_WEIGHT_IMPORTANCE=0.1
# Recency halves every N days since the memory was last used.
MEMORY_HALF_LIFE_DAYS=30
MEMORY_MIN_SIMILARITY=0.5
# Saving a memory at least this similar to an existing one updates it instead.
MEMORY_DEDUP_SIMILARITY=0.9
MEMORY_INJECT_K=5
# Instructions and memories at/above this importance are in every prompt.
MEMORY_CORE_MIN_IMPORTANCE=4
MEMORY_CORE_LIMIT=10
# Extract memories with the LLM after every turn (one extra LLM call, in the background).
MEMORY_AUTO_EXTRACT=true

# ---- Web tools ----
# web_search is offered only when this key is set (free key: https://tavily.com).
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# fetch_url needs no key; it can only reach public addresses (SSRF protection).
WEB_FETCH_ENABLED=true
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=3500
WEB_TIMEOUT_S=10

# ---- Recall Jobs: private job-search pipeline (docs/jobs-plan.md) ----
# Keep false on the public demo: it is meant for a separate private deployment.
JOBS_ENABLED=false
JOBS_RUN_TIMEOUT_S=900
JOBS_FEED_TIMEOUT_S=60
JOBS_HTTP_TIMEOUT_S=15
JOBS_HTTP_MAX_ATTEMPTS=3
JOBS_FEED_CONCURRENCY=4
JOBS_HN_ENABLED=true
# JSON lists. Search queries use WEB_SEARCH_* and are never logged.
JOBS_HN_KEYWORDS=[]
JOBS_SEARCH_QUERIES=[]
JOBS_SEARCH_MAX_RESULTS=10
# LLM extraction (Phase 3): new listings per run, in parallel, per-listing timeout.
JOBS_EXTRACT_MAX_PER_RUN=50
# Skip titles/locations the rules would certainly reject; extract senior titles last.
JOBS_PREFILTER_ENABLED=true
JOBS_EXTRACT_CONCURRENCY=3
JOBS_EXTRACT_TIMEOUT_S=120
JOBS_EXTRACT_MAX_ATTEMPTS=3
# Ranking weights (backend/app/jobs/scoring.py explains each). Relative: they are
# rescaled over the components a job has data for.
JOBS_SCORE_W_SEMANTIC=0.30
JOBS_SCORE_W_TECHNOLOGY=0.25
JOBS_SCORE_W_EXPERIENCE=0.20
JOBS_SCORE_W_LOCATION=0.10
JOBS_SCORE_W_SALARY=0.05
JOBS_SCORE_W_FRESHNESS=0.10
JOBS_SCORE_FRESHNESS_HALF_LIFE_DAYS=14
# Cosine similarity (bge-small) mapped to 0..1; calibrated on live listings.
JOBS_SCORE_SIMILARITY_FLOOR=0.55
JOBS_SCORE_SIMILARITY_CEILING=0.80
# Extra domains never used; linkedin.com and lnkd.in are always denied.
JOBS_DENIED_DOMAINS=[]

# ---- Public demo protection (see deploy/DEPLOY.md) ----
# Leave DEMO_PASSWORD empty for local use (no login screen).
DEMO_PASSWORD=
RATE_LIMIT_CHAT_PER_IP=20
RATE_LIMIT_WINDOW_S=600
# Chat turns per UTC day across all visitors (0 = unlimited).
DAILY_CHAT_LIMIT=0
# Reverse proxies in front of the app (1 on Cloud Run / HF Spaces, 0 locally).
TRUSTED_PROXY_HOPS=0
